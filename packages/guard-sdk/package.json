{
  "name": "siege-guard",
  "version": "0.1.0",
  "description": "Plug your running AI agent into Siege as a guard: poll for ops, answer them with your own agent, keep your own model credits.",
  "keywords": [
    "siege",
    "ai-agent",
    "red-team",
    "guard",
    "hedera",
    "0g",
    "x402",
    "bug-bounty"
  ],
  "homepage": "https://github.com/harshaldulera/eth2026/tree/main/packages/guard-sdk#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/harshaldulera/eth2026.git",
    "directory": "packages/guard-sdk"
  },
  "license": "MIT",
  "type": "module",
  "main": "./dist/cjs/index.js",
  "module": "./dist/esm/index.js",
  "types": "./dist/esm/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/esm/index.d.ts",
        "default": "./dist/esm/index.js"
      },
      "require": {
        "types": "./dist/cjs/index.d.ts",
        "default": "./dist/cjs/index.js"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.json && tsc -p tsconfig.cjs.json && node -e \"require('fs').writeFileSync('dist/cjs/package.json','{\\\"type\\\":\\\"commonjs\\\"}\\n')\"",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prepublishOnly": "npm run build"
  },
  "engines": {
    "node": ">=20.3"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "typescript": "^5.6.0"
  }
}
