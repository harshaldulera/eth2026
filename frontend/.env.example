# ─────────────────────────────────────────────────────────────────────────────
# Siege — environment. Copy to .env.local.
#
#   Stub mode (default) needs NONE of these: `npm run seed && npm run dev` (+ `npm run worker`)
#   works with no Hedera account. Stub transactions start with "stub:" and never touch a network.
#
#   Testnet needs, at minimum:
#     CHAIN_MODE=testnet
#     OWNER_SECRET       (private, 12+ chars — the dev default is refused)
#     HEDERA_OPERATOR_ID / HEDERA_OPERATOR_KEY   (arena account, ECDSA — portal.hedera.com)
#     X402_PAY_TO        (= HEDERA_OPERATOR_ID: where siege fees land)
#     VERIFIER_ADDRESS / VERIFIER_KEY            (a SEPARATE key; worker only)
#     VAULT_ADDRESS      (from `npm run deploy:vault`)
#     RAIDER_OPERATOR_ID / RAIDER_OPERATOR_KEY   (second portal account: the demo raider wallet)
#   then: npm run deploy:vault -> paste VAULT_ADDRESS -> npm run seed -> npm run dev + npm run worker
#   Flipping a stub-seeded DB to testnet is safe: seed recreates vaults/topics/agents for the new
#   chain, and the worker refuses to start until it has. Re-run one castle's demo after it was
#   broken: npm run seed -- --rearm wooden
#
#   Blank keys are commented out on purpose: an uncommented empty `KEY=` is read as "" (set).
# ─────────────────────────────────────────────────────────────────────────────

# ── Mode ─────────────────────────────────────────────────────────────────────
# stub | testnet
CHAIN_MODE=stub
# per-agent: every raider agent gets its own funded Hedera account (AccountCreateTransaction)
# shared:    every agent pays from RAIDER_OPERATOR_ID
RAIDER_ACCOUNT_MODE=per-agent

# ── App ──────────────────────────────────────────────────────────────────────
# SQLite file shared by Next, the worker and scripts (npm run demo uses its own ./data/demo.db)
DATABASE_URL=file:./data/siege.db
# Where the worker reaches the Next server for agent sieges (the real x402 round-trip).
# Use your LAN IP if phones need to open links the server prints.
APP_URL=http://localhost:3000
# The owner key: approves/denies agent requests on /raider/approvals and creates/runs/stops agents
# (sets the httpOnly siege_owner cookie). Stub mode defaults to the public dev key "siege-demo-owner"
# (and the phone page prefills it). CHAIN_MODE=testnet REFUSES to start unless this is set to a
# private value of 12+ characters, e.g.  openssl rand -hex 16
# OWNER_SECRET=

# ── Hedera (testnet) ─────────────────────────────────────────────────────────
HEDERA_NETWORK=testnet
# Arena operator: deploys/calls SiegeVault (the `arena` role), creates HCS topics, funds agents.
# Must be an ECDSA (secp256k1) key, raw hex or DER — ED25519 cannot sign EVM transactions.
# HEDERA_OPERATOR_ID=
# HEDERA_OPERATOR_KEY=
# JSON-RPC relay (chainId 296) and mirror node
HEDERA_RPC_URL=https://testnet.hashio.io/api
HEDERA_MIRROR_URL=https://testnet.mirrornode.hedera.com

# ── SiegeVault ───────────────────────────────────────────────────────────────
# Printed by `npm run deploy:vault` (needs CHAIN_MODE=testnet + operator + verifier).
# VAULT_ADDRESS=
# The verifier signs EIP-712 Releases. Generate a fresh pair:
#   npx tsx -e 'import {generatePrivateKey, privateKeyToAccount} from "viem/accounts"; const k=generatePrivateKey(); console.log(k, privateKeyToAccount(k).address)'
# VERIFIER_KEY is read ONLY by the worker (eslint forbids it in app/ and components/).
# Keep it different from HEDERA_OPERATOR_KEY: arena key + verifier key together can pay any pot.
# Stub mode falls back to a well-known dev key when unset — never fund that address.
# VERIFIER_ADDRESS=
# VERIFIER_KEY=

# Fee split in basis points (must sum to 10000; baked into the contract at deploy time)
FEE_SPLIT_CASTELLAN_BPS=8000
FEE_SPLIT_POT_BPS=1500
FEE_SPLIT_ARENA_BPS=500

# ── x402 payments ────────────────────────────────────────────────────────────
# Facilitator that verifies + settles the Hedera "exact" payments. Alternatives:
#   https://x402.org/facilitator   (default)
#   https://testnet.facilitator.launa.dev
#   https://api.testnet.blocky402.com
FACILITATOR_URL=https://x402.org/facilitator
X402_NETWORK=hedera:testnet
# Account that receives siege fees (0.0.x) — use HEDERA_OPERATOR_ID
# X402_PAY_TO=
# Asset: HBAR = 0.0.0 / 8 decimals. HTS USDC later = 0.0.429274 / 6 / USDC
X402_ASSET=0.0.0
X402_ASSET_DECIMALS=8
X402_ASSET_SYMBOL=HBAR
# One free (never-paying) siege per wallet per UTC day
FREE_SIEGES_PER_DAY=1

# ── Raiders ──────────────────────────────────────────────────────────────────
# The arena's demo raider wallet: pays for the browser "Lay siege" button (POST /api/play/start)
# and, in shared mode, for every agent. A SECOND portal account (ECDSA), not the operator.
# RAIDER_OPERATOR_ID=
# RAIDER_OPERATOR_KEY=

# Ceilings for POST /api/agents (budget / caps in tinybars, and how many agents may exist): every
# per-agent account is funded FROM THE ARENA OPERATOR. Defaults: 20 HBAR, 25 agents.
# AGENT_MAX_BUDGET=2000000000
# AGENT_MAX_COUNT=25
# EVM chain id override for the Release signature (e.g. 298 for a local solo node). Default 296/295.
# HEDERA_CHAIN_ID=

# ── Dev knobs ────────────────────────────────────────────────────────────────
# POST /api/castles/[id]/vault-state (owner cookie) walks a vault through its lifecycle by hand
# (connected / verified / funded / guarding / dormant / closed) until the @siege/guard SDK drives it.
# Always on in stub mode; testnet refuses it unless this is 1. npm run demo sets it for its own process.
# SIEGE_DEV_ENDPOINTS=1
# Skip the stub guardian's simulated 0G latency (300–700ms per reply)
# SIEGE_FAST=1
# Silence the worker's per-action log lines
# WORKER_QUIET=1

# ── Lane B: 0G Private Computer (https://pc.0g.ai) ──
# With ZG_API_KEY set, guardians think on 0G through the vault-scoped proxy (GUARDIAN_MODE=0g);
# without it they use the deterministic stub. Force either with GUARDIAN_MODE=0g|stub.
ZG_API_KEY=
ZG_BASE_URL=https://router-api.0g.ai/v1
ZG_DEFAULT_MODEL=gpt-5.4-mini
# GUARDIAN_MODE=0g
# Ask the router to check provider TEE signatures (no chat providers support it yet).
ZG_VERIFY_TEE=1
# Local dev only: let the verifier accept offline-mock request ids.
# ZG_ALLOW_MOCK_VERIFY=1
