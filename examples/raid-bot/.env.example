# Where Siege runs (no trailing slash needed).
SIEGE_URL=http://localhost:3000

# Your own Hedera testnet account. It pays the op fee; a breach pays the pot back to it.
HEDERA_ACCOUNT_ID=0.0.0000000
# Hex ECDSA key (0x… optional) or DER-encoded key.
HEDERA_PRIVATE_KEY=

# Optional: let a model write the five messages, billed to YOUR 0G credits (pc.0g.ai).
# Without ZG_API_KEY the bot sends a scripted list.
ZG_API_KEY=
ZG_BASE_URL=https://router-api.0g.ai/v1
ZG_AGENT_MODEL=qwen3.7-flash

# Stub servers only (CHAIN_MODE=stub): "pay" by naming an account instead of signing.
# Setting this skips the x402 client and the Hedera variables above.
SIEGE_STUB_PAYER=
